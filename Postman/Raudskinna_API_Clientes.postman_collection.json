        {
          "name": "Listar libros activos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"GET /api/libros responde 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La respuesta es un arreglo JSON\", function () {\r\n    const libros = pm.response.json();\r\n    pm.expect(libros).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Los libros contienen los campos públicos\", function () {\r\n    const libros = pm.response.json();\r\n\r\n    libros.forEach(function (libro) {\r\n        pm.expect(libro).to.have.property(\"id\");\r\n        pm.expect(libro).to.have.property(\"titulo\");\r\n        pm.expect(libro).to.have.property(\"categoria\");\r\n        pm.expect(libro).to.have.property(\"editorial\");\r\n        pm.expect(libro.autores).to.be.an(\"array\");\r\n    });\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
