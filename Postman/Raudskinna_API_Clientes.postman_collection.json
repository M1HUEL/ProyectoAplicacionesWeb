              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Libro inexistente responde 404 Not Found\", function () {\r\n    pm.response.to.have.status(404);\r\n});\r\n\r\npm.test(\"La respuesta contiene un error JSON estructurado\", function () {\r\n    const error = pm.response.json();\r\n\r\n    pm.expect(error).to.have.property(\"estado\", 404);\r\n    pm.expect(error).to.have.property(\"error\", \"Not Found\");\r\n    pm.expect(error).to.have.property(\r\n        \"mensaje\",\r\n        \"El libro solicitado no está disponible.\"\r\n    );\r\n    pm.expect(error).to.have.property(\"ruta\", \"/api/libros/99999\");\r\n    pm.expect(error).to.have.property(\"fechaHora\");\r\n});\r\n"
                ]
