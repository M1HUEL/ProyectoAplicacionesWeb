        {
          "name": "Consultar detalle de libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"GET /api/libros/1 responde 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La respuesta es un objeto JSON\", function () {\r\n    const libro = pm.response.json();\r\n    pm.expect(libro).to.be.an(\"object\");\r\n    pm.expect(libro).to.not.be.an(\"array\");\r\n});\r\n\r\npm.test(\"El libro contiene los campos públicos\", function () {\r\n    const libro = pm.response.json();\r\n\r\n    const idSolicitado = Number(pm.environment.get(\"libroId\"));\r\n    pm.expect(libro).to.have.property(\"id\", idSolicitado);\r\n    pm.expect(libro).to.have.property(\"titulo\");\r\n    pm.expect(libro).to.have.property(\"sinopsis\");\r\n    pm.expect(libro).to.have.property(\"portadaUrl\");\r\n    pm.expect(libro).to.have.property(\"categoria\");\r\n    pm.expect(libro).to.have.property(\"editorial\");\r\n    pm.expect(libro.autores).to.be.an(\"array\");\r\n});\r\n"
                ]
              }
            }
          ],
